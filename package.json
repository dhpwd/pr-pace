{
  "name": "pr-velocity",
  "version": "0.1.0",
  "description": "Measure PR velocity from local git history: PR count, size-weighted PRs, median PR size, lines changed and revert rate per person over time",
  "type": "module",
  "bin": {
    "pr-velocity": "bin/pr-velocity.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "git",
    "pull-requests",
    "velocity",
    "metrics",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
